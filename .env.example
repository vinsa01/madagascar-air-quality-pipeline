# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs.
# .env est dans .gitignore : il ne doit JAMAIS être commité ni apparaître
# dans l'historique Git.

# --- Connexion au data warehouse (Supabase ou Neon, PostgreSQL) ---
DB_HOST=xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSLMODE=require

# --- API (optionnel) ---
# Open-Meteo ne nécessite pas de clé pour l'usage non-commercial de ce projet.
# Si vous changez de fournisseur d'API (ex: OpenWeatherMap) et qu'une clé est
# requise, ajoutez-la ici, jamais en dur dans le code.
# AIR_QUALITY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
